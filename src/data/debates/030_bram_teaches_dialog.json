  },
  "rounds": [
    {
      "kind": "npc",
      "id": "round-1",
      "roundNumber": 1,
      "type": "opening_constructive",
      "speakerId": "bram",
      "impact": 0,
      "statement": {
        "id": "stmt-r1-bram",
        "speakerId": "bram",
        "type": "opening_constructive",
        "sentences": [
          {
            "id": "s-r1-1",
            "text": "A conversation here goes in rounds. One animal says a thing. The other answers. That pair is a round.",
            "logicalFallacies": []
          },
          {
            "id": "s-r1-2",
            "text": "I go, then you go. That is the whole of it.",
            "logicalFallacies": []
          }
        ]
      }
    },
    {
      "kind": "player",
      "id": "round-2",
      "roundNumber": 2,
      "type": "opening_constructive",
      "preventOptionsShuffle": true,
      "opponentPromptImpact": 0,
      "opponentPrompt": {
        "id": "stmt-r2-bram",
        "speakerId": "bram",
        "type": "opening_constructive",
        "sentences": [
          {
            "id": "s-r2-p1",
            "text": "Your turn. Three ways of saying it. There is no wrong one.",
            "logicalFallacies": []
          }
        ]
      },
      "options": [
        {
          "id": "r2-opt-a",
          "quality": "ineffective",
          "impact": 0,
          "reason": "You changed the subject. Kind, and not an answer — so the round never quite happened.",
          "sentences": [
            {
              "id": "s-r2-opt-a-1",
              "text": "The fence looks fine from here. You worry too much.",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r2-opt-b",
          "quality": "effective",
          "impact": 8,
          "reason": "You said what a round is, in your own words. That is the whole of the lesson so far.",
          "sentences": [
            {
              "id": "s-r2-opt-b-1",
              "text": "So I wait until you have finished, and then I say something back, and that pair is a round.",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r2-opt-c",
          "quality": "effective",
          "impact": 8,
          "reason": "You named the two halves. Short, and it covers it.",
          "sentences": [
            {
              "id": "s-r2-opt-c-1",
              "text": "You go, then I go.",
              "logicalFallacies": []
            }
          ]
        }
      ],
      "opponentResponses": [
        {
          "forOptionId": "r2-opt-a",
          "impact": 0,
          "statement": {
            "id": "resp-r2-a",
            "speakerId": "bram",
            "type": "opening_constructive",
            "sentences": [
              {
                "id": "s-resp-r2-a-1",
                "text": "Kind. Not an answer. A round is you answering what I said.",
                "logicalFallacies": []
              }
            ]
          }
        },
        {
          "forOptionId": "r2-opt-b",
          "impact": 0,
          "statement": {
            "id": "resp-r2-b",
            "speakerId": "bram",
            "type": "opening_constructive",
            "sentences": [
              {
                "id": "s-resp-r2-b-1",
                "text": "Yes. That is exactly it.",
                "logicalFallacies": []
              }
            ]
          }
        },
        {
          "forOptionId": "r2-opt-c",
          "impact": 0,
          "statement": {
            "id": "resp-r2-c",
            "speakerId": "bram",
            "type": "opening_constructive",
            "sentences": [
              {
                "id": "s-resp-r2-c-1",
                "text": "Yes. You go, then I go.",
                "logicalFallacies": []
              }
            ]
          }
        }
      ]
    },
    {
      "kind": "player",
      "id": "round-3",
      "roundNumber": 3,
      "type": "crossfire",
      "preventOptionsShuffle": true,
      "opponentPromptImpact": 0,
      "opponentPrompt": {
        "id": "stmt-r3-bram",
        "speakerId": "bram",
        "type": "crossfire",
        "sentences": [
          {
            "id": "s-r3-p1",
            "text": "Some rounds are not speeches. Somebody asks and you answer on your feet. They call that crossfire.",
            "logicalFallacies": []
          },
          {
            "id": "s-r3-p2",
            "text": "This half is I ask, you answer. Why did Dot send you to me, and not to Cass?",
            "logicalFallacies": []
          }
        ]
      },
      "options": [
        {
          "id": "r3-opt-a",
          "quality": "ineffective",
          "impact": 0,
          "reason": "You answered a different question. Kind, and not what he asked.",
          "sentences": [
            {
              "id": "s-r3-opt-a-1",
              "text": "Cass is a fox. I thought I would start somewhere quieter.",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r3-opt-b",
          "quality": "effective",
          "impact": 0,
          "reason": "You answered the question he asked, about Dot, without decorating it.",
          "sentences": [
            {
              "id": "s-r3-opt-b-1",
              "text": "She said you would show me how a conversation works here, before Cass got her teeth into me.",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r3-opt-c",
          "quality": "effective",
          "impact": 0,
          "reason": "Short, and it is still an answer. Crossfire does not need a speech.",
          "sentences": [
            {
              "id": "s-r3-opt-c-1",
              "text": "She said you first.",
              "logicalFallacies": []
            }
          ]
        }
      ]
    },
    {
      "kind": "player",
      "id": "round-4",
      "roundNumber": 4,
      "type": "crossfire",
      "preventOptionsShuffle": true,
      "options": [
        {
          "id": "r4-opt-a",
          "quality": "ineffective",
          "impact": 0,
          "reason": "A yes-or-no about his feelings. He can wriggle out of it, and you will not have asked him anything that needed answering on his feet.",
          "sentences": [
            {
              "id": "s-r4-opt-a-1",
              "text": "Are you all right? You look like you would rather be checking the fence.",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r4-opt-b",
          "quality": "effective",
          "impact": 0,
          "reason": "You asked him something he has to answer. That is the other half of crossfire.",
          "sentences": [
            {
              "id": "s-r4-opt-b-1",
              "text": "If I ask you a question in the middle of a conversation, do you have to answer it?",
              "logicalFallacies": []
            }
          ]
        },
        {
          "id": "r4-opt-c",
          "quality": "effective",
          "impact": 0,
          "reason": "You named the thing and asked him to confirm it. He has to say yes.",
          "sentences": [
            {
              "id": "s-r4-opt-c-1",
              "text": "This half is me asking, and you answering. Is that right?",
              "logicalFallacies": []
            }
          ]
        }
      ],
      "opponentResponses": [
        {
          "forOptionId": "r4-opt-a",
          "impact": 0,
          "statement": {
            "id": "resp-r4-a",
            "speakerId": "bram",
            "type": "crossfire",
            "sentences": [
              {
                "id": "s-resp-r4-a-1",
                "text": "That is a kind question and not the kind I meant. Ask me something I have to answer, not something I can wriggle out of.",
                "logicalFallacies": []
              }
            ]
          }
        },
        {
          "forOptionId": "r4-opt-b",
          "impact": 0,
          "statement": {
            "id": "resp-r4-b",
            "speakerId": "bram",
            "type": "crossfire",
            "sentences": [
              {
                "id": "s-resp-r4-b-1",
                "text": "In crossfire, yes. That is the point of it. I would rather not, usually, but that is not the same as not having to.",
                "logicalFallacies": []
              }
            ]
          }
        },
        {
          "forOptionId": "r4-opt-c",
          "impact": 0,
          "statement": {
            "id": "resp-r4-c",
            "speakerId": "bram",
            "type": "crossfire",
            "sentences": [
              {
                "id": "s-resp-r4-c-1",
                "text": "Yes. You ask, I answer. I am doing it now.",
                "logicalFallacies": []
              }
            ]
          }
        }
      ]
    }
  ],
