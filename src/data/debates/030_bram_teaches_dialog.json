{
  "id": "level1-bram-teaches-dialog",
  "introduction": "The wolf at the fence will show you how a conversation works on this farm, one piece at a time, before anyone else gets hold of you.",
  "playerSide": "opposition",
  "characters": {
    "bram": "Bram",
    "rue": "Rue"
  },
  "logicalFallacies": [],
  "availableLogicalFallacies": [],
  "setsDialogFlags": ["bram-taught-crossfire"],
  "unlocksFeatures": ["round_types"],
  "mechanics": {
    "analysisEnabled": false,
    "showInsightPoints": false,
    "showModeratorOpinion": true,
    "showRoundRecap": false,
    "showIntroSummary": false,
    "revealChoiceAssessment": true,
    "encounterKind": "lesson",
