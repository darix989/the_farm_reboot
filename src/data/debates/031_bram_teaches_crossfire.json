{
  "id": "level1-bram-teaches-crossfire",
  "introduction": "Bram is still at the fence, and he has one more thing, if you have a moment. He says you do not have to. He would not blame you.",
  "playerSide": "opposition",
  "characters": {
    "bram": "Bram",
    "rue": "Rue"
  },
  "logicalFallacies": [],
  "availableLogicalFallacies": [],
